# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Host-local Postgres (docker-compose maps db:5432 to localhost:5432)
DATABASE_URL=postgresql+psycopg://newnews:newnews@localhost:5432/newnews
# Inside the compose network use the service name instead:
# DATABASE_URL=postgresql+psycopg://newnews:newnews@db:5432/newnews

# --- Auth ---
# Admin key used to mint client API keys (POST /api/v1/clients). Change it.
ADMIN_API_KEY=change-me-admin

# --- AI provider: "stub" (default, deterministic, offline) | "groq" (M2) ---
AI_PROVIDER=stub
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# --- Pipeline tuning ---
CREDIBILITY_VERIFIED_THRESHOLD=0.75
CREDIBILITY_REVIEW_THRESHOLD=0.45
WORKER_POLL_INTERVAL_MS=200
SSE_POLL_INTERVAL_MS=200
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5

# --- Storage ---
MEDIA_ROOT=/data/media

# --- Tests ---
# Point at a disposable database; schema is created/dropped by the test harness.
# TEST_DATABASE_URL=postgresql+psycopg://newnews:newnews@localhost:5432/newnews_test
